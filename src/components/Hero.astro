---
const WA = 'https://wa.me/543424470962?text=Hola%2C%20quiero%20hablar%20con%20Magno%20Studio%20sobre%20mi%20proyecto%20web.';

const stats = [
  { num: '100',  label: 'Score Lighthouse',    icon: '⚡' },
  { num: '< 1s', label: 'Tiempo de carga',     icon: '🚀' },
  { num: '+40%', label: 'Más conversiones',    icon: '📈' },
  { num: '4+',   label: 'Años de experiencia', icon: '🏆' },
];
---

<section class="hero" id="inicio">

  <!-- Grid decorativo de fondo -->
  <div class="hero-bg-grid" aria-hidden="true"></div>

  <!-- Luz ambiental -->
  <div class="hero-ambient"></div>
  <div class="hero-line-h"></div>

  <div class="container hero-inner">

    <!-- Columna izquierda: texto -->
    <div class="hero-content">

      <div class="hero-tag fade-up" style="animation-delay:0.05s">
        <span class="tag-dot"></span>
        <span>Agencia disponible · Santa Fe, Argentina</span>
      </div>

      <h1 class="hero-title fade-up" style="animation-delay:0.18s">
        <span class="title-pre">Diseño,</span>
        <em>velocidad</em>
        <span class="title-amp">&amp;</span>
        <strong>conversión.</strong>
      </h1>

      <p class="hero-desc fade-up" style="animation-delay:0.32s">
        En Magno Studio construimos sitios web que trabajan por tu negocio las 24 horas.
        Landings de alta conversión, embudos de venta y sitios institucionales premium
        desarrollados con <strong>Astro</strong> — el framework más rápido del mercado.
        <br/><br/>
        Tu competencia usa WordPress. Vos usás Magno Studio.
      </p>

      <div class="hero-actions fade-up" style="animation-delay:0.46s">
        <a href={WA} target="_blank" rel="noopener" class="btn btn-gold">
          Quiero mi sitio premium →
        </a>
        <a href="#portafolio" class="btn btn-ghost">
          Ver trabajos
        </a>
      </div>

      <!-- Stats -->
      <div class="hero-stats fade-up" style="animation-delay:0.6s">
        {stats.map(s => (
          <div class="stat">
            <span class="stat-icon">{s.icon}</span>
            <span class="stat-num">{s.num}</span>
            <span class="stat-label">{s.label}</span>
          </div>
        ))}
      </div>

    </div>

    <!-- Columna derecha: hero-image -->
    <div class="hero-visual fade-up" style="animation-delay:0.5s">
      <div class="hero-img-wrapper">
        <img
          src="/images/hero-image.png"
          alt="Magno Studio — desarrollo web premium"
          class="hero-img"
          width="500"
          height="560"
        />
        <!-- Efecto glow detrás de la imagen -->
        <div class="hero-img-glow"></div>
      </div>

      <!-- Floating cards -->
      <div class="float-card fc1">
        <span>🔥</span>
        <div>
          <strong>Lanzamiento exitoso</strong>
          <small>CAMEES · Sitio live en producción</small>
        </div>
      </div>
      <div class="float-card fc2">
        <span>⚡</span>
        <div>
          <strong>0.3s carga</strong>
          <small>vs 4.2s WordPress</small>
        </div>
      </div>
    </div>

  </div>

  <!-- Marquee de tecnologías -->
  <div class="hero-marquee">
    <div class="marquee-track">
      {['Astro', 'HTML5', 'CSS3', 'JavaScript', 'Node.js', 'Netlify', 'GitHub', 'Figma',
        'Astro', 'HTML5', 'CSS3', 'JavaScript', 'Node.js', 'Netlify', 'GitHub', 'Figma'].map(t => (
        <span class="marquee-item">
          <span class="marquee-dot">◆</span> {t}
        </span>
      ))}
    </div>
  </div>

</section>

<style>
.hero {
  position: relative;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding-top: 80px;
  overflow: hidden;
}

/* Fondo grid */
.hero-bg-grid {
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(rgba(201,169,110,0.04) 1px, transparent 1px),
    linear-gradient(90deg, rgba(201,169,110,0.04) 1px, transparent 1px);
  background-size: 60px 60px;
  mask-image: radial-gradient(ellipse 80% 60% at 50% 0%, black 40%, transparent 100%);
  pointer-events: none;
}

/* Luz ambiental */
.hero-ambient {
  position: absolute;
  top: -10%;
  left: 30%;
  width: 900px; height: 700px;
  background: radial-gradient(ellipse, rgba(201,169,110,0.055) 0%, transparent 65%);
  pointer-events: none;
}
.hero-line-h {
  position: absolute;
  top: 80px; left: 0; right: 0;
  height: 1px;
  background: linear-gradient(to right, transparent, rgba(201,169,110,0.08), transparent);
}

/* Layout */
.hero-inner {
  position: relative;
  z-index: 2;
  display: grid;
  grid-template-columns: 1fr 480px;
  gap: 72px;
  align-items: center;
  padding-top: 40px;
  padding-bottom: 60px;
}

/* Tag */
.hero-tag {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-size: 0.7rem;
  font-weight: 500;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--white-soft);
  margin-bottom: 24px;
}
.tag-dot {
  width: 7px; height: 7px;
  border-radius: 50%;
  background: #3dd68c;
  animation: pulse-gold 2s ease-in-out infinite;
}

/* Título */
.hero-title {
  font-size: clamp(2.8rem, 5.5vw, 5.2rem);
  font-weight: 200;
  color: var(--white);
  margin-bottom: 24px;
  letter-spacing: -0.03em;
  line-height: 1.0;
}
.title-pre { display: block; }
.hero-title em {
  display: block;
  font-style: italic;
  font-weight: 200;
  background: linear-gradient(135deg, var(--gold-dk), var(--gold), var(--gold-lt), var(--gold));
  background-size: 300% auto;
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  animation: shimmer 5s linear infinite;
}
.title-amp {
  display: inline;
  color: var(--white-dim);
  font-style: normal;
  font-weight: 200;
}
.hero-title strong {
  display: block;
  font-weight: 600;
  color: var(--white);
  -webkit-text-fill-color: var(--white);
}

/* Desc */
.hero-desc {
  font-size: 1rem;
  color: var(--white-soft);
  line-height: 1.8;
  font-weight: 300;
  margin-bottom: 36px;
  max-width: 520px;
}
.hero-desc strong { color: var(--white); font-weight: 500; }

/* Actions */
.hero-actions { display: flex; gap: 14px; flex-wrap: wrap; margin-bottom: 48px; }

/* Stats */
.hero-stats {
  display: flex;
  gap: 32px;
  flex-wrap: wrap;
  padding-top: 32px;
  border-top: 1px solid var(--border);
}
.stat { display: flex; flex-direction: column; gap: 2px; }
.stat-icon { font-size: 1rem; margin-bottom: 4px; }
.stat-num {
  font-family: var(--font-display);
  font-size: 1.8rem;
  font-weight: 400;
  color: var(--gold);
  line-height: 1;
}
.stat-label {
  font-size: 0.68rem;
  color: var(--white-soft);
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

/* ── Hero image ── */
.hero-visual { position: relative; }

.hero-img-wrapper {
  position: relative;
  border-radius: var(--radius);
  overflow: hidden;
}

.hero-img {
  width: 100%;
  height: auto;
  display: block;
  border-radius: var(--radius);
  border: 1px solid rgba(201,169,110,0.15);
  box-shadow:
    0 24px 80px rgba(0,0,0,0.7),
    0 0 0 1px rgba(201,169,110,0.08);
  transition: transform 0.5s ease;
}
.hero-visual:hover .hero-img { transform: scale(1.01); }

.hero-img-glow {
  position: absolute;
  inset: -2px;
  border-radius: var(--radius);
  background: linear-gradient(135deg, rgba(201,169,110,0.08) 0%, transparent 60%);
  pointer-events: none;
  z-index: 1;
}

/* Float cards */
.float-card {
  position: absolute;
  display: flex;
  align-items: center;
  gap: 10px;
  background: rgba(8,8,8,0.95);
  border: 1px solid rgba(201,169,110,0.2);
  border-radius: 8px;
  padding: 12px 16px;
  box-shadow: 0 8px 32px rgba(0,0,0,0.6);
  white-space: nowrap;
  z-index: 3;
}
.float-card > span { font-size: 1.2rem; flex-shrink: 0; }
.float-card strong { display: block; font-size: 0.8rem; font-weight: 600; color: var(--white); }
.float-card small  { font-size: 0.68rem; color: var(--white-soft); }
.fc1 { bottom: 20px; left: -30px; animation: float 5s ease-in-out infinite; }
.fc2 { top: 24px; right: -30px; animation: float 7s ease-in-out infinite 1s; }

/* Marquee */
.hero-marquee {
  position: relative;
  z-index: 2;
  border-top: 1px solid var(--border);
  background: rgba(201,169,110,0.02);
  padding: 16px 0;
  overflow: hidden;
}
.marquee-track {
  display: inline-flex;
  gap: 0;
  animation: marquee 20s linear infinite;
  white-space: nowrap;
}
.marquee-item {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  padding: 0 28px;
  font-size: 0.72rem;
  font-weight: 500;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--white-soft);
}
.marquee-dot { color: var(--gold); font-size: 0.5rem; opacity: 0.5; }

@media (max-width: 1060px) {
  .hero-inner { grid-template-columns: 1fr; gap: 48px; }
  .hero-visual { max-width: 480px; margin: 0 auto; }
  .fc1 { bottom: 10px; left: 0; }
  .fc2 { top: 10px; right: 0; }
}
@media (max-width: 600px) {
  .hero-title { font-size: 2.8rem; }
  .hero-stats  { gap: 20px; }
  .float-card  { display: none; }
}
</style>
