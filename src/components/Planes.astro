---
const WA = 'https://wa.me/543424470962?text=Hola%2C%20me%20interesa%20el%20plan%20';

const planes = [
  {
    nombre: 'Esencial',
    emoji: '⚡',
    precio: 'USD 150',
    desc: 'Para emprendedores que necesitan presencia digital profesional sin demoras.',
    features: [
      'Landing page hasta 5 secciones',
      'Diseño responsive mobile-first',
      'Formulario de contacto activo',
      'Integración con WhatsApp',
      'Optimización SEO básica',
      'Deploy en Netlify incluido',
      'Score Lighthouse 90+',
      '1 revisión de diseño',
    ],
    noFeatures: ['Blog / CMS', 'Dominio propio', 'Mantenimiento'],
    destacado: false,
    msg: 'Esencial%20(USD%20150)',
  },
  {
    nombre: 'Pro',
    emoji: '🚀',
    precio: 'USD 320',
    desc: 'Para infoproductores que necesitan embudo completo y contenido actualizable.',
    features: [
      'Todo el plan Esencial',
      'Hasta 8 secciones a medida',
      'Blog con CMS Keystatic',
      'Panel de administración propio',
      'Integración email marketing',
      'Score Lighthouse 100',
      'Carga en menos de 1 segundo',
      '3 revisiones de diseño',
      'Soporte 30 días post-entrega',
    ],
    noFeatures: ['Dominio propio'],
    destacado: true,
    msg: 'Pro%20(USD%20320)',
  },
  {
    nombre: 'Premium',
    emoji: '👑',
    precio: 'USD 580',
    desc: 'Solución integral para lanzamientos de alto impacto con embudo completo.',
    features: [
      'Todo el plan Pro',
      'Embudo de ventas completo',
      'Captura + Ventas + Gracias',
      'Animaciones avanzadas',
      'Integración pasarela de pago',
      'Score Lighthouse 100 garantizado',
      'Carga en menos de 0.5 segundos',
      'Revisiones ilimitadas',
      'Soporte 60 días post-entrega',
      'Sesión estratégica 1:1',
    ],
    noFeatures: [],
    destacado: false,
    msg: 'Premium%20(USD%20580)',
  },
];
---

<section id="planes" class="planes">
  <div class="container">

    <div class="planes-header reveal">
      <span class="eyebrow">Inversión</span>
      <h2 class="section-title">
        Precios claros.<br/>
        <em>Resultados medibles.</em>
      </h2>
      <p class="planes-sub">
        Sin costos ocultos. Sin sorpresas. Elegís el plan que se adapta a tu momento y escalás cuando estés listo.
      </p>
    </div>

    <div class="planes-grid">
      {planes.map((p, i) => (
        <div class={`plan reveal ${p.destacado ? 'plan-destacado' : ''}`} style={`animation-delay:${i*0.12}s`}>

          {p.destacado && <div class="plan-ribbon">Más elegido</div>}

          <div class="plan-top">
            <div class="plan-icon">{p.emoji}</div>
            <span class="plan-nombre">{p.nombre}</span>
            <div class="plan-precio">
              <span class="precio-val">{p.precio}</span>
              <span class="precio-tipo">pago único</span>
            </div>
            <p class="plan-desc">{p.desc}</p>
          </div>

          <div class="plan-div"></div>

          <ul class="plan-features">
            {p.features.map(f => (
              <li class="yes"><span>✓</span>{f}</li>
            ))}
            {p.noFeatures.map(f => (
              <li class="no"><span>✗</span>{f}</li>
            ))}
          </ul>

          <a
            href={`${WA}${p.msg}`}
            target="_blank"
            rel="noopener"
            class={`plan-btn ${p.destacado ? 'btn btn-gold' : 'btn btn-ghost'}`}
          >
            Empezar con {p.nombre} →
          </a>

        </div>
      ))}
    </div>

    <!-- Mantenimiento -->
    <div class="mant-card reveal">
      <div class="mant-left">
        <span class="mant-icon">🔧</span>
        <div>
          <h4>Plan de Mantenimiento Mensual</h4>
          <p>Actualizaciones ilimitadas de contenido, nuevas secciones, monitoreo de performance y soporte técnico prioritario. Tu sitio siempre actualizado y funcionando.</p>
        </div>
      </div>
      <a
        href="https://wa.me/543424470962?text=Hola%2C%20quiero%20consultar%20el%20plan%20de%20mantenimiento%20mensual%20de%20Magno%20Studio."
        target="_blank"
        rel="noopener"
        class="btn btn-ghost"
      >
        Consultar precio →
      </a>
    </div>

  </div>
</section>

<style>
.planes { background: var(--void); }

.planes-header { margin-bottom: 72px; }
.planes-sub { font-size: 1rem; color: var(--white-soft); font-weight: 300; margin-top: 12px; max-width: 480px; }

.planes-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
  margin-bottom: 32px;
  align-items: start;
}

.plan {
  background: var(--void-card);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 36px 30px;
  position: relative;
  transition: border-color 0.3s, transform 0.3s;
}
.plan:hover { border-color: var(--border-gold); transform: translateY(-4px); }
.plan-destacado {
  border-color: rgba(201,169,110,0.35);
  background: rgba(201,169,110,0.03);
  transform: translateY(-8px);
  box-shadow: 0 0 60px rgba(201,169,110,0.08);
}
.plan-destacado:hover { transform: translateY(-12px); }

.plan-ribbon {
  position: absolute;
  top: -14px;
  left: 50%;
  transform: translateX(-50%);
  background: var(--gold);
  color: var(--void);
  font-size: 0.62rem;
  font-weight: 700;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  padding: 5px 16px;
  border-radius: 40px;
  white-space: nowrap;
}

.plan-icon { font-size: 1.6rem; margin-bottom: 10px; display: block; }
.plan-nombre {
  display: block;
  font-size: 0.68rem;
  font-weight: 700;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: var(--gold);
  margin-bottom: 14px;
}
.plan-precio {
  display: flex;
  align-items: baseline;
  gap: 8px;
  margin-bottom: 12px;
}
.precio-val {
  font-family: var(--font-display);
  font-size: 2.6rem;
  font-weight: 300;
  color: var(--white);
  line-height: 1;
}
.precio-tipo { font-size: 0.7rem; color: var(--white-soft); font-weight: 300; }
.plan-desc { font-size: 0.84rem; color: var(--white-soft); line-height: 1.6; font-weight: 300; }

.plan-div { height: 1px; background: var(--border); margin: 24px 0; }

.plan-features { list-style: none; margin-bottom: 28px; }
.plan-features li {
  display: flex;
  align-items: flex-start;
  gap: 9px;
  font-size: 0.82rem;
  padding: 5px 0;
  line-height: 1.4;
}
.plan-features li.yes { color: var(--white-soft); }
.plan-features li.no  { color: var(--white-dim); text-decoration: line-through; opacity: 0.4; }
.plan-features li span { font-size: 0.7rem; font-weight: 700; margin-top: 2px; flex-shrink: 0; }
.plan-features li.yes span { color: var(--gold); }
.plan-features li.no span  { color: var(--white-dim); }

.plan-btn { width: 100%; justify-content: center; padding: 12px 20px; font-size: 0.8rem; }

/* Mantenimiento */
.mant-card {
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 28px 36px;
  display: flex;
  align-items: center;
  gap: 28px;
  background: rgba(201,169,110,0.02);
}
.mant-left { display: flex; align-items: center; gap: 20px; flex: 1; }
.mant-icon { font-size: 2rem; flex-shrink: 0; }
.mant-left h4 {
  font-size: 1rem;
  font-weight: 400;
  color: var(--white);
  margin-bottom: 4px;
  font-family: var(--font-display);
}
.mant-left p { font-size: 0.82rem; color: var(--white-soft); font-weight: 300; line-height: 1.6; }

@media (max-width: 900px) {
  .planes-grid { grid-template-columns: 1fr; }
  .plan-destacado { transform: none; }
  .mant-card { flex-direction: column; align-items: flex-start; }
}
</style>
