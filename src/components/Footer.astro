---
const WA = 'https://wa.me/543424470962?text=Hola%2C%20quiero%20iniciar%20un%20proyecto%20con%20Magno%20Studio.';
const IG = 'https://www.instagram.com/magnostudioweb';
const LI = 'https://www.linkedin.com/in/josé-carlomagno-015a8810b';
const GH = 'https://github.com/Carlom4gn0';
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer-top-line"></div>
  <div class="container footer-inner">

    <!-- Brand -->
    <div class="footer-brand">
      <a href="/" class="footer-logo">
        <img
          src="/favicon.png"
          alt="Magno Studio Web"
          class="footer-logo-img"
          width="40"
          height="40"
        />
        <div>
          <span class="f-logo-name">Magno Studio</span>
          <span class="f-logo-sub">Web Agency</span>
        </div>
      </a>
      <p>Diseño, velocidad y conversión. Landings premium y embudos de venta construidos con Astro para infoproductores y empresas digitales.</p>
      <div class="footer-soc">
        <a href={IG} target="_blank" rel="noopener" aria-label="Instagram" class="soc ig">
