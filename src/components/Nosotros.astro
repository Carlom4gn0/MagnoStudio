---
const WA = 'https://wa.me/543424470962?text=Hola%20Jos%C3%A9%2C%20quiero%20hablar%20de%20mi%20proyecto%20con%20Magno%20Studio.';
const GH = 'https://github.com/Carlom4gn0';
const LI = 'https://www.linkedin.com/in/josé-carlomagno-015a8810b';
---

<section id="nosotros" class="nosotros">
  <div class="container nosotros-inner">

    <div class="nos-text reveal-left">
      <span class="eyebrow">Quiénes somos</span>
      <h2 class="section-title">
        Una agencia con el<br/>
        enfoque de un<br/>
        <em>especialista.</em>
      </h2>
      <p>
        Magno Studio Web no es una agencia de decenas de empleados con proyectos genéricos en serie.
        Somos un estudio boutique liderado por <strong>José Carlomagno</strong>, desarrollador web
        con más de 4 años de experiencia construyendo presencia digital para negocios que quieren
        resultados reales.
      </p>
      <p>
        Eso significa que cada proyecto lo recibe un experto, no un junior. Cada línea de código
        la escribe alguien que entiende tu negocio y tiene incentivos para que funcione. La atención
        es directa, la comunicación es clara y el trabajo se entrega en tiempo y forma.
      </p>
      <p>
        Trabajamos con el stack tecnológico más moderno disponible — <strong>Astro, Node.js y Netlify</strong> —
        para garantizar sitios con velocidad absoluta, seguridad total y cero costos de hosting ocultos.
      </p>

      <div class="nos-valores">
        {[
          { icon: '🎯', label: 'Orientado a resultados' },
          { icon: '⚡', label: 'Velocidad técnica real' },
          { icon: '🤝', label: 'Trato directo y honesto' },
          { icon: '🔒', label: 'Código limpio y seguro' },
        ].map(v => (
          <div class="valor">
            <span>{v.icon}</span>
            <strong>{v.label}</strong>
          </div>
        ))}
      </div>
    </div>

    <div class="nos-foto reveal-right">
      <div class="foto-frame">
        <!-- Reemplazá con tu foto: public/images/jose.jpg -->
        <img src="/images/jose.jpg" alt="José Carlomagno — Fundador Magno Studio Web" />
        <div class="foto-overlay"></div>
      </div>

      <div class="founder-card">
        <div class="founder-info">
          <strong>José Carlomagno</strong>
          <span>Founder & Lead Developer</span>
        </div>
        <div class="founder-links">
          <a href={GH} target="_blank" rel="noopener" class="flink" aria-label="GitHub">
            <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
          </a>
          <a href={LI} target="_blank" rel="noopener" class="flink" aria-label="LinkedIn">
            <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          </a>
        </div>
      </div>

      <div class="foto-deco"></div>
    </div>

  </div>
</section>

<style>
.nosotros { background: var(--void-soft); }

.nosotros-inner {
  display: grid;
  grid-template-columns: 1fr 440px;
  gap: 96px;
  align-items: center;
}

.nos-text p {
  font-size: 0.95rem;
  color: var(--white-soft);
  line-height: 1.85;
  font-weight: 300;
  margin-bottom: 18px;
}
.nos-text p strong { color: var(--white); font-weight: 500; }

.nos-valores {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
  margin-top: 32px;
}
.valor {
  display: flex;
  align-items: center;
  gap: 10px;
  background: var(--void-card);
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  padding: 12px 16px;
  transition: border-color 0.2s;
}
.valor:hover { border-color: var(--border-gold); }
.valor span { font-size: 1.1rem; }
.valor strong { font-size: 0.78rem; font-weight: 500; color: var(--white); letter-spacing: 0.02em; }

/* Foto */
.nos-foto { position: relative; }
.foto-frame {
  border-radius: var(--radius);
  overflow: hidden;
  aspect-ratio: 4/5;
  background: var(--void-card);
  border: 1px solid var(--border);
  position: relative;
}
.foto-frame img {
  width: 100%; height: 100%;
  object-fit: cover;
  object-position: top;
  transition: transform 0.6s;
}
.nos-foto:hover .foto-frame img { transform: scale(1.03); }
.foto-overlay {
  position: absolute; inset: 0;
  background: linear-gradient(to top, rgba(8,8,8,0.55) 0%, transparent 50%);
}

.founder-card {
  position: absolute;
  bottom: -18px; left: -18px;
  background: rgba(8,8,8,0.96);
  border: 1px solid var(--border-gold);
  border-radius: var(--radius-sm);
  padding: 16px 20px;
  display: flex;
  align-items: center;
  gap: 16px;
  backdrop-filter: blur(8px);
  box-shadow: 0 8px 32px rgba(0,0,0,0.6);
}
.founder-info strong { display: block; font-size: 0.9rem; font-weight: 600; color: var(--white); }
.founder-info span   { display: block; font-size: 0.7rem; color: var(--gold); opacity: 0.8; letter-spacing: 0.06em; }
.founder-links { display: flex; gap: 8px; }
.flink {
  width: 30px; height: 30px;
  border-radius: var(--radius-sm);
  background: rgba(255,255,255,0.05);
  border: 1px solid var(--border);
  display: flex; align-items: center; justify-content: center;
  color: var(--white-soft);
  transition: all 0.2s;
}
.flink:hover { border-color: var(--border-gold); color: var(--gold); }

.foto-deco {
  position: absolute;
  top: -16px; right: -16px;
  width: 100px; height: 100px;
  border: 1px solid rgba(201,169,110,0.12);
  border-radius: 4px;
  z-index: -1;
}

@media (max-width: 960px) {
  .nosotros-inner { grid-template-columns: 1fr; gap: 56px; }
  .nos-foto { max-width: 400px; margin: 0 auto; }
  .founder-card { left: 0; }
}
@media (max-width: 500px) {
  .nos-valores { grid-template-columns: 1fr; }
}
</style>
